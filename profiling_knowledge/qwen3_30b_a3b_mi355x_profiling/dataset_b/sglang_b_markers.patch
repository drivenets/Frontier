+    async def frontier_b_drain(self, capture_id: str, timeout_s: float = 60.0):
+        """Dataset B: broadcast FrontierBDrainReqInput to every TP rank and
+        wait for every rank's own ack before returning. Returns the list of
+        FrontierBDrainReqOutput acks (one per rank) on success; raises
+        asyncio.TimeoutError if any rank does not ack in time, and the driver
+        (run_b.py) must treat that as a hard failure, never send a
+        termination signal, and preserve what state exists for diagnosis."""
