+@app.post("/frontier_b_drain")
+@auth_level(AuthLevel.ADMIN_OPTIONAL)
+async def frontier_b_drain(request: Request):
+    """Dataset B: explicit, acknowledged end-of-measurement drain. Broadcasts
+    to every TP rank's scheduler and waits for every rank's own ack
+    (FrontierBDrainReqOutput) before returning. The caller (run_b.py) must
+    treat a non-200 response, a timeout, or any ack with success=false as a
+    hard failure and must not send a termination signal in that case -- this
+    endpoint intentionally does not attempt shutdown itself."""
+    try:
+        body = await request.json()
+        capture_id = body["capture_id"]
+    except (TypeError, KeyError, ValueError) as e:
+        return ORJSONResponse(
+            {"success": False, "message": f"invalid request body: {e}"},
+            status_code=HTTPStatus.BAD_REQUEST,
+        )
+    try:
+        acks = await _global_state.tokenizer_manager.frontier_b_drain(capture_id)
+    except asyncio.TimeoutError:
+        return ORJSONResponse(
+            {"success": False, "message": "timed out waiting for all ranks to ack the drain"},
+            status_code=HTTPStatus.GATEWAY_TIMEOUT,
+        )
+    all_success = all(a.success for a in acks)
+    return ORJSONResponse(
+        {
+            "success": all_success,
+            "capture_id": capture_id,
+            "acks": [
+                {
+                    "success": a.success,
+                    "process_id": a.process_id,
+                    "rank": a.rank,
+                    "capture_id": a.capture_id,
+                    "record_count": a.record_count,
+                    "overflow": a.overflow,
+                    "flush_path": a.flush_path,
+                    "error": a.error,
+                }
+                for a in acks
+            ],
+        },
+        status_code=200 if all_success else HTTPStatus.INTERNAL_SERVER_ERROR,
+    )
+
